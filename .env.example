# Copy to .env and fill in as needed. All values are optional.

# Port the backend listens on (frontend dev server proxies /api to it).
PORT=5174

# Where downloaded videos, transcripts and rendered clips are stored.
# Defaults to <repo>/workspace
# WORKSPACE_DIR=/absolute/path/to/workspace

# faster-whisper model size: tiny | base | small | medium | large-v3
# Bigger = more accurate, slower. "small" is a good default on a laptop.
WHISPER_MODEL=small

# Python interpreter used for transcription. Defaults to the repo venv.
# PYTHON_BIN=/Users/you/work/REA/reelay/.venv/bin/python

# Highlight selection uses Claude when this is set; otherwise a built-in
# heuristic picks moments. Also REQUIRED for AI explainer mode (web-researched
# voiceover script). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# AI explainer voiceover (Piper TTS). Defaults point at the venv binary and the
# voice downloaded by scripts/setup-python.sh.
# PIPER_BIN=/path/to/.venv/bin/piper
# PIPER_VOICE=/path/to/voices/en_US-lessac-medium.onnx
# EXPLAINER_MAX_SECONDS=600

# YouTube cookies — needed when YouTube blocks yt-dlp with a "Sign in to confirm
# you're not a bot" error (common from servers / datacenter IPs like HF Spaces).
# Local machine: pull cookies straight from your browser.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Server: point at a Netscape cookies.txt exported from a logged-in browser,
# YTDLP_COOKIES=/path/to/cookies.txt
# …or, where only env secrets are available (HF Spaces), base64 the cookies.txt
# (`base64 -i cookies.txt`) and set it here — it's written to a file at startup.
# YTDLP_COOKIES_B64=

# Binaries — only set these if they are not already on PATH.
# YTDLP_BIN=/opt/homebrew/bin/yt-dlp
#
# IMPORTANT for burned-in captions: the ffmpeg you point at must be built with
# libass (the `subtitles`/`ass` filters). The slim homebrew `ffmpeg` formula is
# NOT — install the full build with `brew install ffmpeg-full` and point here:
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
